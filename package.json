{
  "name": "epoch-browser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node --test scripts/release.test.mjs",
    "test:e2e": "playwright test",
    "deploy": "pnpm test && pnpm build && node scripts/release.mjs stage",
    "deploy:check": "pnpm test && pnpm build && node scripts/release.mjs stage --dry-run",
    "deploy:production": "node scripts/release.mjs production",
    "deploy:production:check": "node scripts/release.mjs production --dry-run"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.0"
  }
}
